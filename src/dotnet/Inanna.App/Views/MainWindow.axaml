<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="using:Inanna.ViewModels"
        x:Class="Inanna.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="Inanna"
        Width="550" Height="660"
        MinWidth="200" MinHeight="150"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="{DynamicResource AppAccentStrong}"
              BorderBrush="{DynamicResource AppText}"
              BorderThickness="0,0,0,2"
              Padding="24,20">

          <Border BorderBrush="{DynamicResource AppPaper}"
                  BorderThickness="2"
                  Padding="7,6">

              <Viewbox Stretch="Fill"
                        Height="96"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
              <TextBlock Text="Inanna"
                        FontFamily="{StaticResource AppDisplayFontFamily}"
                        FontSize="44"
                        LetterSpacing="-1.6"
                        Foreground="{DynamicResource AppPaper}" />
              </Viewbox>

          </Border>
      </Border>

      <StackPanel Grid.Row="1" Margin="32,26,32,30" Spacing="20">
        <Border IsVisible="{Binding ShowApplicationUpdatePanel}"
                Background="{DynamicResource AppPanel}"
                BorderBrush="{DynamicResource AppText}"
                BorderThickness="2"
                Padding="20,18">
          <StackPanel Spacing="10">
            <TextBlock Text="Update available"
                       FontSize="18"
                       FontWeight="Normal"
                       Foreground="{DynamicResource AppText}" />
            <TextBlock Text="{Binding ApplicationUpdateStatus}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppText}" />
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding ApplicationUpdateProgress}"
                         IsVisible="{Binding ApplicationUpdateBusy}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary"
                      Content="Download and restart"
                      Command="{Binding InstallApplicationUpdateCommand}"
                      IsEnabled="{Binding CanInstallApplicationUpdate}" />
              <Button Classes="panelAction"
                      Content="Later"
                      Command="{Binding DeferApplicationUpdateCommand}"
                      IsEnabled="{Binding !ApplicationUpdateBusy}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding ShowInstallPanel}"
                Background="{DynamicResource AppAccentStrong}"
                Padding="20,18">
          <StackPanel Spacing="10">
            <TextBlock Text="Required tools are not installed."
                       FontSize="18"
                       FontWeight="Normal"
                       Foreground="{DynamicResource AppPaper}" />
            <TextBlock Text="{Binding UpdateSummary}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppPaper}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="panelAction"
                      Content="Install tools"
                      Command="{Binding InstallToolsCommand}"
                      IsEnabled="{Binding CanInstallTools}" />
              <Button Content="Retry check"
                      Command="{Binding CheckToolsCommand}"
                      IsEnabled="{Binding CanBrowse}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding ShowUpdatePanel}"
                Background="{DynamicResource AppPanel}"
                BorderBrush="{DynamicResource AppText}"
                BorderThickness="2"
                Padding="20,18">
          <StackPanel Spacing="10">
            <TextBlock Text="Tool updates are available."
                       FontSize="18"
                       FontWeight="Normal"
                       Foreground="{DynamicResource AppText}" />
            <TextBlock Text="{Binding UpdateSummary}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppText}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary"
                      Content="Update"
                      Command="{Binding InstallToolsCommand}"
                      IsEnabled="{Binding CanInstallTools}" />
              <Button Classes="panelAction"
                      Content="Later"
                      Command="{Binding DeferUpdateCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBox Height="48"
                  Text="{Binding Url}"
                  PlaceholderText="Paste a video URL…"
                  IsEnabled="{Binding CanEdit}"
                  AutomationProperties.Name="URL">
          <TextBox.InnerRightContent>
            <Button Classes="clearInput"
                    Content="✕"
                    Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding HasUrl}"
                  Background="Transparent"
                  BorderThickness="0"
                    AutomationProperties.Name="Clear URL" />
          </TextBox.InnerRightContent>
        </TextBox>

        <Border Background="{DynamicResource AppPanel}"
                BorderBrush="{DynamicResource AppText}"
                BorderThickness="2"
              Padding="18,16">
            <StackPanel Spacing="0">
            <Slider Margin="10,4,10,0"
                    Minimum="0" Maximum="3" TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding VideoQuality}"
                    IsEnabled="{Binding CanChangeQuality}"
                    AutomationProperties.Name="Quality, audio only, 1080p, 1440p, or best" />
            <Grid Margin="10,0"
              Height="34"
                  ColumnDefinitions="0,*,0,*,0,*,0"
                  ClipToBounds="False">
              <Viewbox Grid.Column="0"
                       Width="42" Height="34"
                       HorizontalAlignment="Left"
                       Stretch="Fill">
                <TextBlock Text="Audio"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           Foreground="{DynamicResource AppText}" />
              </Viewbox>
              <Viewbox Grid.Column="2" Width="42" Height="34" Stretch="Fill">
                <TextBlock Text="1080p"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           Foreground="{DynamicResource AppText}" />
              </Viewbox>
              <Viewbox Grid.Column="4" Width="42" Height="34" Stretch="Fill">
                <TextBlock Text="1440p"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           Foreground="{DynamicResource AppText}" />
              </Viewbox>
              <Viewbox Grid.Column="6"
                       Width="42" Height="34"
                       HorizontalAlignment="Right"
                       Stretch="Fill">
                <TextBlock Text="Best"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           Foreground="{DynamicResource AppText}" />
              </Viewbox>
            </Grid>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Height="48"
                    Text="{Binding OutputFolder}"
                    IsReadOnly="True"
                    AutomationProperties.Name="Output" />
          <Button Grid.Column="1"
              Width="80"
                  MinHeight="48"
                  Content="Browse"
                  Command="{Binding BrowseOutputCommand}"
                  IsEnabled="{Binding CanBrowse}" />
        </Grid>

        <ProgressBar Minimum="0" Maximum="100"
                     Value="{Binding Progress}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}" />

        <Border BorderBrush="{DynamicResource AppLine}"
                BorderThickness="0,1,0,0"
                Padding="0,18,0,0">
          <StackPanel Spacing="12">
              <Grid Height="85" ColumnDefinitions="*,Auto">
              <Button Classes="primary"
                      IsVisible="{Binding ShowDownloadButton}"
                      Content="Download"
                      Command="{Binding StartDownloadCommand}"
                  IsEnabled="{Binding CanDownload}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Margin="8,0,0,0"
              IsVisible="{Binding ShowCancelButton}"
              Content="Cancel"
              Command="{Binding CancelCommand}" />
            <Button Margin="8,0,0,0"
              IsVisible="{Binding ShowDetailsButton}"
              Content="{Binding DetailsButtonText}"
              Command="{Binding ToggleDetailsCommand}" />
            <Button Margin="8,0,0,0"
              IsVisible="{Binding ShowRestartButton}"
              Content="Restart engine"
              Command="{Binding RestartBackendCommand}" />
                </StackPanel>
              </Grid>
            <TextBlock Classes="status"
                       Classes.error="{Binding Failed}"
                       IsVisible="{Binding ShowStatusText}"
                       FontSize="16"
                       FontWeight="Normal"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
            <HyperlinkButton IsVisible="{Binding HasCompletedFile}"
                             HorizontalAlignment="Left"
                             Foreground="{DynamicResource AppAccentStrong}"
                             Content="{Binding StatusText}"
                             Command="{Binding OpenFolderCommand}"
                             AutomationProperties.Name="Show downloaded file in file manager" />
          </StackPanel>
        </Border>

        <TextBox Classes="details"
                 IsVisible="{Binding ShowDetails}"
                 Text="{Binding DetailsText}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Error details" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
