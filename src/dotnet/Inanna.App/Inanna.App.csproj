<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Stable executable identity retained so existing Velopack installs update in place. -->
    <AssemblyName>yt-dlp-wrapper</AssemblyName>
    <RootNamespace>Inanna</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">../../../assets/app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../assets/icons/app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="../../../assets/icons/app-icon.ico" Link="Assets/app-icon.ico" />
    <AvaloniaResource Include="../../../assets/fonts/**/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <Target Name="SetVersionFromGitTag" BeforeTargets="GetAssemblyVersion">
    <PropertyGroup>
      <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../..'))</RepositoryRoot>
    </PropertyGroup>
    <Exec Command="git -c safe.directory=&quot;$(RepositoryRoot)&quot; describe --tags --abbrev=0 --match &quot;v[0-9]*&quot;"
          WorkingDirectory="$(RepositoryRoot)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitVersionTag" />
    </Exec>
    <PropertyGroup>
      <Version>$([System.Text.RegularExpressions.Regex]::Replace('$(GitVersionTag)', '^v', ''))</Version>
    </PropertyGroup>
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$')) != 'true'"
           Text="Git tag $(GitVersionTag) does not contain a supported semantic version." />
  </Target>
</Project>
